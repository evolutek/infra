   "locked": false
  },
  {
   "id": "text-84",
   "type": "text",
   "x": 10,
   "y": 688,
   "width": 386.1,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 199753325,
   "version": 1,
   "versionNonce": 92886140,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ce qui protège\n- rien n'écoute sur Internet : tout part de l'intérieur\n- SSH par clé, avec une clé par administrateur\n- OmniRoute n'écoute que sur la machine\n- déploiement relu par PR\n- UPnP, NAT-PMP et PCP coupés sur Tailscale",
   "originalText": "Ce qui protège\n- rien n'écoute sur Internet : tout part de l'intérieur\n- SSH par clé, avec une clé par administrateur\n- OmniRoute n'écoute que sur la machine\n- déploiement relu par PR\n- UPnP, NAT-PMP et PCP coupés sur Tailscale",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-82",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "box-85",
