   "link": null,
   "locked": false
  },
  {
   "id": "text-87",
   "type": "text",
   "x": 485,
   "y": 688,
   "width": 365.04,
   "height": 81.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 500336924,
   "version": 1,
   "versionNonce": 1846463633,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ce qui reste fragile\n- un seul administrateur, une seule clé déclarée\n- tailnet partagé : pas de trace de qui s'y connecte\n- SSH local ouvert à quiconque est sur ce réseau,\n  mais seulement avec une clé autorisée",
   "originalText": "Ce qui reste fragile\n- un seul administrateur, une seule clé déclarée\n- tailnet partagé : pas de trace de qui s'y connecte\n- SSH local ouvert à quiconque est sur ce réseau,\n  mais seulement avec une clé autorisée",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-85",
   "autoResize": true,
   "lineHeight": 1.25
  },
