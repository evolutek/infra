   "roundness": null,
   "seed": 439558928,
   "version": 1,
   "versionNonce": 1647066734,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Si un service externe tombe\n- Tailscale : plus d'accès distant à coup sûr ; SSH local\n- GitHub : plus de déploiement ; la machine tourne\n- Discord : les bots sont muets\n- fournisseurs : l'agent se rabat sur un autre, ou se tait",
   "originalText": "Si un service externe tombe\n- Tailscale : plus d'accès distant à coup sûr ; SSH local\n- GitHub : plus de déploiement ; la machine tourne\n- Discord : les bots sont muets\n- fournisseurs : l'agent se rabat sur un autre, ou se tait",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "box-88",
   "autoResize": true,
   "lineHeight": 1.25
