   "text": "NixOS, disques chiffrés\nservices seulement en local",
   "originalText": "NixOS, disques chiffrés\nservices seulement en local",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "box-82",
